{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                // === 基础选项 ===
                "-fdiagnostics-color=always",    // 错误信息带颜色
                "-g",                            // 生成调试信息 (GDB用)

                // === 优化选项 (取消注释以启用) ===
                // "-O0",                       // 不优化，便于调试
                // "-O1",                       // 基本优化
                // "-O2",                       // 常规优化 (推荐生产环境)
                // "-O3",                       // 激进优化 (性能测试)
                // "-Ofast",                    // 最高级别优化 (可能不完全标准兼容)
                // "-Os",                       // 优化代码大小

                // === 警告选项 ===
                "-Wall",                         // 开启所有常见警告
                "-Wextra",                       // 开启额外警告
                // "-Werror",                     // 将警告视为错误
                // "-Wshadow",                    // 变量遮蔽警告
                // "-Wconversion",                // 隐式类型转换警告
                // "-Wpedantic",                  // 严格ISO标准合规

                // === 架构优化 ===
                // "-march=native",             // 针对本机CPU优化指令集
                // "-mtune=native",             // 针对本机CPU调优
                // "-mavx2",                    // 启用AVX2指令集
                // "-mavx512f",                 // 启用AVX-512指令集

                // === 性能分析 ===
                // "-pg",                       // 生成gprof性能分析数据
                // "-flto",                     // 链接时优化 (Link-Time Optimization)
                // "-funroll-loops",            // 循环展开 (编译器自动)
                // "-fprofile-generate",        // 生成Profile数据 (PGO第一步)
                // "-fprofile-use",             // 使用Profile数据 (PGO第二步)

                // === 调试/检测 ===
                // "-fsanitize=address",        // 内存访问检测 (ASan)
                // "-fsanitize=undefined",      // 未定义行为检测 (UBSan)

                // === 标准/库 ===
                // "-std=c11",                  // C11标准
                // "-std=c17",                  // C17标准
                // "-fopenmp",                  // 启用OpenMP支持
                // "-lm",                       // 链接数学库

                // === 输出 ===
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}